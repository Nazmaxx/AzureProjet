				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "https://prod-22.francecentral.logic.azure.com:443/workflows/fd6579c14a9f49ddbec9d15c3fa250ae/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=220ltiPz_pLeK5yx60f3eJcrQhwBipLhHEAsWalBAwE",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    \"pipeline_name\" : \"@{pipeline().Pipeline}\",\n    \"run_id\" : \"@{pipeline().RunId}\", \n    \"status\" : \"@{activity('ExecuteIncrementalIngestion').Status}\",\n    \"error\" : \"@{if(equals(activity('ExecuteIncrementalIngestion').Status, 'Failed'), string(activity('ExecuteIncrementalIngestion').error), 'No error')}\"\n}\n",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"files": {
				"type": "array",
				"defaultValue": [
					{
						"file_name": "DimPassenger.csv"
					},
					{
						"file_name": "DimFlight.csv"
					},
					{
						"file_name": "DimAirline.csv"
					}
				]
			}
		},
